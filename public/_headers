# Portfolio demo — keep every page and image out of search results.
/*
  X-Robots-Tag: noindex, nofollow

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Generated by app/icon.tsx and app/apple-icon.tsx — exported without a file
# extension, so the content type has to be set explicitly.
/icon
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
